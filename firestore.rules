rules_version = '2';

// Browsers may add survey answers (src/survey/questions.ts), read and edit
// parts of their own account, and manage a parent's child profiles
// (src/account/schema.ts). Accounts are created by `completeSignup`, so
// `role`, `access` and the consent times never come from a browser. Class
// requests and classes are read-only here (src/account/classRequest.ts). Impact data
// (`impact_batches`, `impact_daily`) has no rule here, so browsers can't
// touch it at all: only the functions in functions/src/index.ts read and
// write it, and the admin dashboard gets totals through `impactReport`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{id} {
      allow create: if validAnswer(request.resource.data);
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      // Only these fields change from a browser; the rest is set by functions.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lang', 'survey', 'training', 'mailing'])
        && validEdit(request.resource.data, resource.data);

      // Child profiles, c1 to c6, so there are never more than six. Each keeps
      // its progress and its blocks per session.
      match /children/{childId} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && childId in ['c1', 'c2', 'c3', 'c4', 'c5', 'c6']
          && get(/databases/$(database)/documents/users/$(uid)).data.role == 'parent'
          && validChild(request.resource.data);

        match /blocks/{sessionId} {
          allow read, delete: if isSelf(uid);
          allow write: if isSelf(uid) && childId in ['c1', 'c2', 'c3', 'c4', 'c5', 'c6'] && validBlocks(request.resource.data);
        }
      }
    }

    // Class requests are written only by functions (functions/src/classes.ts),
    // which count the limit. The educator who sent one and admins read it.
    match /classRequests/{id} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || request.auth.token.admin == true);
    }

    // A class is read by its educator. `codes`, which maps a class code to its
    // class, has no rule: only functions read it.
    match /classes/{id} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Students (functions/src/members.ts). The educator reads them all, for
      // the class page; a student reads and updates only their own progress
      // and where they are now. `names` and `keys` have no rule.
      match /members/{memberId} {
        allow read: if isClassOwner(id) || isMember(id, memberId);
        allow update: if isMember(id, memberId) && validMemberUpdate(request.resource.data, resource.data);

        match /blocks/{sessionId} {
          allow read: if isMember(id, memberId);
          allow write: if isMember(id, memberId) && validBlocks(request.resource.data);
        }
      }
    }
  }

  function isSelf(uid) {
    return request.auth != null && request.auth.uid == uid;
  }

  function text(s, max) {
    return s is string && s.size() >= 1 && s.size() <= max;
  }

  function validEdit(d, before) {
    return text(d.displayName, 60)
      && d.lang in ['id', 'en']
      && (d.survey == before.survey || (before.role == 'educator' && validSurvey(d.survey)))
      && d.training in ['yes', 'no', null]
      && (d.mailing == before.mailing
        || (d.mailing.keys().hasOnly(['optIn', 'at']) && d.mailing.optIn is bool
          && (d.mailing.optIn ? d.mailing.at == request.time : d.mailing.at == null)));
  }

  function validSurvey(s) {
    return s.keys().hasOnly(['institution', 'city', 'grades', 'source'])
      && s.institution in ['smp', 'sd', 'sma', 'campus', 'community', 'other']
      && text(s.city, 60)
      && s.grades is list && s.grades.size() >= 1 && s.grades.hasOnly(['7', '8', '9', 'other'])
      && s.source in ['colleague', 'social', 'search', 'event', 'school', 'other'];
  }

  function isMember(classId, memberId) {
    // token.get(): adults' tokens have no student claims, and a missing key would be an error.
    return request.auth != null && request.auth.token.get('student', false) == true
      && request.auth.token.get('classId', '') == classId && request.auth.token.get('memberId', '') == memberId;
  }

  function isClassOwner(classId) {
    // Functions sit outside `match /databases/{database}`, so the database is named here.
    return request.auth != null && get(/databases/(default)/documents/classes/$(classId)).data.ownerUid == request.auth.uid;
  }

  // Only `progress` and `live` change, and each is checked only when it does:
  // a progress save leaves `live.at` as it was.
  function validMemberUpdate(after, before) {
    let changed = after.diff(before).affectedKeys();
    return changed.hasOnly(['progress', 'live'])
      && (!('progress' in changed) || validProgress(after.progress))
      && (!('live' in changed) || validLive(after.live));
  }

  // Progress is the player's own record (src/store/progress.ts); its size is
  // capped by the document limit.
  function validProgress(p) {
    return p == null || p is map;
  }

  function validLive(l) {
    return l == null
      || (l.keys().hasOnly(['session', 'puzzle', 'since', 'runs', 'hint', 'at'])
        && (l.session == null || (l.session is string && l.session.size() <= 12))
        && (l.puzzle == null || (l.puzzle is string && l.puzzle.size() <= 24))
        && (l.since == null || l.since is timestamp)
        && l.runs is int && l.runs >= 0
        && l.hint is int && l.hint >= 0 && l.hint <= 3
        && l.at == request.time);
  }

  function validBlocks(b) {
    return b.keys().hasOnly(['json', 'at']) && b.json is string && b.json.size() <= 200000 && b.at == request.time;
  }

  function validChild(c) {
    return c.keys().hasOnly(['nickname', 'avatar', 'createdAt', 'progress'])
      && validProgress(c.get('progress', null))
      && text(c.nickname, 20)
      && c.avatar in ['🐝', '🐦', '🐸', '🦅', '🤖', '🌈', '🌙', '🌳', '🍎', '🏀', '🎲', '⭐']
      && c.createdAt is timestamp;
  }

  function scale(n) {
    return n is int && n >= 1 && n <= 5;
  }

  function validAnswer(d) {
    return d.keys().hasOnly(['v', 'role', 'session', 'fun', 'clear', 'stuck', 'again', 'essay', 'lang', 'device', 'at'])
      && d.keys().hasAll(['v', 'role', 'session', 'fun', 'clear', 'stuck', 'again', 'essay', 'lang', 'device', 'at'])
      && d.v == 1
      && d.role in ['student', 'teacher', 'parent', 'other']
      && (d.session == null || (d.session is string && d.session.size() <= 12))
      && scale(d.fun)
      && scale(d.clear)
      && d.stuck is list && d.stuck.size() <= 6
      && d.stuck.hasOnly(['mission', 'blocks', 'run', 'result', 'words', 'none'])
      && d.again in ['yes', 'maybe', 'no']
      && d.essay is string && d.essay.size() <= 600
      && d.lang in ['id', 'en']
      && d.device in ['phone', 'wide']
      && d.at == request.time;
  }
}
